{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "lint: watch",
      "type": "shell",
      "command": "node scripts/lint-watch.mjs",
      "isBackground": true,
      "problemMatcher": {
        "base": "$eslint-stylish",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^lint: start$",
          "endsPattern": "^lint: done$"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
